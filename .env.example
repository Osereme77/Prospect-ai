# Local frontend values. Copy to .env.local and fill from Supabase Project Settings > API.
# These are public browser values and are still protected by Auth and RLS.
# Never put a Supabase secret/service_role key here. Legacy anon keys are
# accepted as VITE_SUPABASE_ANON_KEY when migrating older project setups.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
